<Application x:Class="WindowsProgramInventory.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsProgramInventory.UI.ViewModels"
             xmlns:views="clr-namespace:WindowsProgramInventory.UI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The active theme dictionary (Light/Dark) is inserted at index 0 by ThemeService at startup. -->
                <ResourceDictionary Source="UI/Themes/Base.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Page ↔ View mapping -->
            <DataTemplate DataType="{x:Type vm:ProgramsViewModel}">
                <views:ProgramsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
                <views:StatisticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>