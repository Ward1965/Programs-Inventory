<UserControl x:Class="WindowsProgramInventory.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:WindowsProgramInventory.Core">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />

            <!-- Appearance -->
            <TextBlock Text="{x:Static core:Strings.SettingsAppearance}" Style="{StaticResource SectionLabelStyle}" Margin="0,24,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static core:Strings.SettingsTheme}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Left"
                          ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" />
            </Grid>

            <!-- Startup -->
            <TextBlock Text="{x:Static core:Strings.SettingsStartup}" Style="{StaticResource SectionLabelStyle}" Margin="0,20,0,6" />
            <CheckBox Content="{x:Static core:Strings.SettingsRefreshOnStartup}"
                      IsChecked="{Binding RefreshOnStartup}" />

            <!-- Report -->
            <TextBlock Text="{x:Static core:Strings.SettingsReport}" Style="{StaticResource SectionLabelStyle}" Margin="0,20,0,6" />
            <WrapPanel>
                <Button Content="{x:Static core:Strings.ExportPdf}" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ExportPdfCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static core:Strings.ExportMarkdown}" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ExportMarkdownCommand}" />
            </WrapPanel>

            <!-- Cache -->
            <TextBlock Text="{x:Static core:Strings.SettingsCache}" Style="{StaticResource SectionLabelStyle}" Margin="0,20,0,6" />
            <WrapPanel>
                <Button Content="{x:Static core:Strings.ClearIconCache}" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ClearIconCacheCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static core:Strings.ClearInventoryCache}" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ClearInventoryCacheCommand}" Margin="0,0,8,0" />
                <Button Content="{x:Static core:Strings.ClearAllData}" Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding ClearAllDataCommand}" />
            </WrapPanel>

            <!-- Diagnostics -->
            <TextBlock Text="{x:Static core:Strings.Diagnostics}" Style="{StaticResource SectionLabelStyle}" Margin="0,20,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="10,8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LogsPath}" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding LogsPath}" />
                </Border>
                <Button Grid.Column="1" Content="{x:Static core:Strings.ShowLogs}" Style="{StaticResource GhostButtonStyle}"
                        Margin="8,0,0,0" Command="{Binding ShowLogsCommand}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>