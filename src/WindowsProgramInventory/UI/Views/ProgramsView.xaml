<UserControl x:Class="WindowsProgramInventory.UI.Views.ProgramsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WindowsProgramInventory.Models"
             xmlns:conv="clr-namespace:WindowsProgramInventory.UI.Converters"
             xmlns:core="clr-namespace:WindowsProgramInventory.Core">

    <UserControl.Resources>
        <conv:ProgramStatusToBrushConverter x:Key="StatusToBrush" />

        <!-- Compact list row: icon | name | publisher | status | details -->
        <DataTemplate x:Key="ListTemplate" DataType="{x:Type models:ProgramInfo}">
            <Border Margin="4" Padding="10,0"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Command="{Binding DataContext.LaunchProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="{x:Static core:Strings.RunProgram}"
                            Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IconPlaceholderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Width="28" Height="28">
                            <Border CornerRadius="6"
                                    Background="{DynamicResource IconPlaceholderBrush}"
                                    Visibility="{Binding IconCachePath, Converter={StaticResource NullToVis}}" />
                            <Image Source="{Binding IconCachePath, Converter={StaticResource IconToImage}}"
                                   Stretch="Uniform" Margin="2"
                                   Visibility="{Binding IconCachePath, Converter={StaticResource NotNullToVis}}" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Grid.Column="2" Text="{Binding Publisher}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Border Grid.Column="3" VerticalAlignment="Center"
                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                            CornerRadius="9" Padding="10,3">
                        <TextBlock Text="{Binding DisplayStatus}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BadgeForegroundBrush}" />
                    </Border>

                    <Button Grid.Column="4" x:Name="ListDetailsToggle" VerticalAlignment="Center" Margin="10,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,4" FontSize="11"
                            Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static core:Strings.ShowDetails}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                            <Setter Property="Text" Value="{x:Static core:Strings.HideDetails}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Popup IsOpen="{Binding IsDetailsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=ListDetailsToggle}"
                           Placement="Bottom" AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Width="300" Padding="12"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Path: " />
                                    <Run Text="{Binding PathSummary, Mode=OneWay, TargetNullValue={x:Static core:Strings.NotAvailable}}" />
                                </TextBlock>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Location: " />
                                    <Run Text="{Binding InstallLocation, Mode=OneWay, TargetNullValue={x:Static core:Strings.NotAvailable}}" />
                                </TextBlock>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Version: " />
                                    <Run Text="{Binding Version, Mode=OneWay, TargetNullValue={x:Static core:Strings.NotAvailable}}" />
                                </TextBlock>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Arch: " />
                                    <Run Text="{Binding Architecture, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate" DataType="{x:Type models:ProgramInfo}">
            <Border Width="190" Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    Margin="4" Padding="12,14"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Clickable icon: runs the program -->
                    <Button Grid.Row="0" HorizontalAlignment="Center"
                            Command="{Binding DataContext.LaunchProgramCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            ToolTip="{x:Static core:Strings.RunProgram}"
                            Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="12" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource IconPlaceholderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              MinWidth="32" MinHeight="32" Margin="0,0,0,10">
                            <Border CornerRadius="12"
                                    Background="{DynamicResource IconPlaceholderBrush}"
                                    Visibility="{Binding IconCachePath, Converter={StaticResource NullToVis}}">
                                <Border Width="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Multiply}, ConverterParameter=0.5}"
                                        Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Multiply}, ConverterParameter=0.5}"
                                        MinWidth="16" MinHeight="16" CornerRadius="8"
                                        Background="{DynamicResource AccentBrush}" Opacity="0.85"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Source="{Binding IconCachePath, Converter={StaticResource IconToImage}}"
                                   Stretch="Uniform" Margin="3"
                                   Visibility="{Binding IconCachePath, Converter={StaticResource NotNullToVis}}" />
                        </Grid>
                    </Button>

                    <TextBlock Grid.Row="1" Text="{Binding Name}" TextAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxHeight="34" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Grid.Row="2" Text="{Binding Publisher}" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />

                    <Border Grid.Row="3" Margin="0,10,0,0" HorizontalAlignment="Center"
                            Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                            CornerRadius="9" Padding="10,3">
                        <TextBlock Text="{Binding DisplayStatus}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BadgeForegroundBrush}" />
                    </Border>

                    <!-- Details toggle (the panel itself is a Popup so card heights stay uniform) -->
                    <Button Grid.Row="4" x:Name="DetailsToggle" HorizontalAlignment="Center" Margin="0,10,0,0"
                            Style="{StaticResource GhostButtonStyle}" Padding="12,4" FontSize="11"
                            Command="{Binding DataContext.ToggleDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static core:Strings.ShowDetails}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailsOpen}" Value="True">
                                            <Setter Property="Text" Value="{x:Static core:Strings.HideDetails}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Floating details popup: path, install location, version, architecture -->
                    <Popup IsOpen="{Binding IsDetailsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=DetailsToggle}"
                           Placement="Bottom" AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Width="300" Padding="12"
                                Background="{DynamicResource WindowBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Path: " />
                                    <Run Text="{Binding PathSummary, Mode=OneWay, TargetNullValue={x:Static core:Strings.NotAvailable}}" />
                                </TextBlock>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Location: " />
                                    <Run Text="{Binding InstallLocation, Mode=OneWay, TargetNullValue={x:Static core:Strings.NotAvailable}}" />
                                </TextBlock>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Version: " />
                                    <Run Text="{Binding Version, Mode=OneWay, TargetNullValue={x:Static core:Strings.NotAvailable}}" />
                                </TextBlock>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <Run Text="Arch: " />
                                    <Run Text="{Binding Architecture, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Count header -->
        <TextBlock Grid.Row="0" Margin="0,0,0,10"
                   Text="{Binding CountLabel}" VerticalAlignment="Center" />

        <!-- Empty state (first run) -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
            <TextBlock FontFamily="{StaticResource GlyphFont}" FontSize="56" Text="&#xE8F1;"
                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyTitle}" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Text="{x:Static core:Strings.EmptyHint}" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Program grid: sliding-viewport rendering keeps large inventories fluid -->
        <ScrollViewer x:Name="ScrollHost" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="OnScrollChanged" SizeChanged="OnSizeChanged"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
            <Grid Height="{Binding EstimatedContentHeight}">
                <ItemsControl ItemsSource="{Binding Programs}" Tag="{Binding IconSize}"
                              Width="{Binding ItemsAreaWidth}"
                              VerticalAlignment="Top" HorizontalAlignment="Left">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource CardTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsListView}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ListTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.RenderTransform>
                        <TranslateTransform Y="{Binding ContentOffsetY}" />
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="{Binding DataContext.ItemWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       ItemHeight="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>