<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Light palette -->
    <Color x:Key="ThemeWindowBackground">#F3F3F3</Color>
    <Color x:Key="ThemeSidebarBackground">#FAFAFA</Color>
    <Color x:Key="ThemeCardBackground">#FFFFFF</Color>
    <Color x:Key="ThemeCardHover">#ECECEC</Color>
    <Color x:Key="ThemeCardBorder">#E2E2E2</Color>
    <Color x:Key="ThemeTextPrimary">#1B1B1B</Color>
    <Color x:Key="ThemeTextSecondary">#5B5B5B</Color>
    <Color x:Key="ThemeTextTertiary">#8A8A8A</Color>
    <Color x:Key="ThemeAccent">#0067C0</Color>
    <Color x:Key="ThemeAccentSoft">#CCE4F7</Color>
    <Color x:Key="ThemeDivider">#E4E4E4</Color>
    <Color x:Key="ThemeControlBackground">#FFFFFF</Color>
    <Color x:Key="ThemeControlHover">#F0F0F0</Color>
    <Color x:Key="ThemeControlBorder">#D1D1D1</Color>
    <Color x:Key="ThemeSelectionBackground">#DCEBF7</Color>
    <Color x:Key="ThemeStatusBarBackground">#F7F7F7</Color>
    <Color x:Key="ThemeSearchBackground">#FFFFFF</Color>
    <Color x:Key="ThemeSidebarHover">#EFEFEF</Color>
    <Color x:Key="ThemeGlyphInactive">#5B5B5B</Color>
    <Color x:Key="ThemeIconPlaceholder">#E8E8E8</Color>

    <Color x:Key="ThemeBadgeInstalled">#107C10</Color>
    <Color x:Key="ThemeBadgeShortcut">#0067C0</Color>
    <Color x:Key="ThemeBadgeBoth">#9D5D00</Color>
    <Color x:Key="ThemeBadgeBroken">#C42B1C</Color>
    <Color x:Key="ThemeBadgeNeutral">#6E6E6E</Color>

</ResourceDictionary>