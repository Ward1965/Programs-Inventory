<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:conv="clr-namespace:WindowsProgramInventory.UI.Converters">

    <!-- ── Fonts ─────────────────────────────────────────────── -->
    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="GlyphFont">Segoe MDL2 Assets</FontFamily>

    <!-- ── Brushes (derive from the active theme colors) ────── -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource ThemeWindowBackground}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{DynamicResource ThemeSidebarBackground}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource ThemeCardBackground}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{DynamicResource ThemeCardHover}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource ThemeCardBorder}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource ThemeTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource ThemeTextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource ThemeTextTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource ThemeAccent}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource ThemeAccentSoft}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource ThemeDivider}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ThemeControlBackground}" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ThemeControlHover}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource ThemeControlBorder}" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{DynamicResource ThemeSelectionBackground}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{DynamicResource ThemeStatusBarBackground}" />
    <SolidColorBrush x:Key="SearchBackgroundBrush" Color="{DynamicResource ThemeSearchBackground}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{DynamicResource ThemeSidebarHover}" />
    <SolidColorBrush x:Key="GlyphInactiveBrush" Color="{DynamicResource ThemeGlyphInactive}" />
    <SolidColorBrush x:Key="IconPlaceholderBrush" Color="{DynamicResource ThemeIconPlaceholder}" />

    <SolidColorBrush x:Key="BadgeInstalledBrush" Color="{DynamicResource ThemeBadgeInstalled}" />
    <SolidColorBrush x:Key="BadgeShortcutBrush" Color="{DynamicResource ThemeBadgeShortcut}" />
    <SolidColorBrush x:Key="BadgeBothBrush" Color="{DynamicResource ThemeBadgeBoth}" />
    <SolidColorBrush x:Key="BadgeBrokenBrush" Color="{DynamicResource ThemeBadgeBroken}" />
    <SolidColorBrush x:Key="BadgeNeutralBrush" Color="{DynamicResource ThemeBadgeNeutral}" />
    <SolidColorBrush x:Key="BadgeForegroundBrush" Color="White" />
    <SolidColorBrush x:Key="ScanOverlayBrush" Color="#6E2C2C2C" />

    <!-- ── Converters ────────────────────────────────────────── -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    <conv:NullToVisibilityConverter x:Key="NullToVis" />
    <conv:NotNullToVisibilityConverter x:Key="NotNullToVis" />
    <conv:MultiplyConverter x:Key="Multiply" />
    <conv:IconPathToImageConverter x:Key="IconToImage" />

    <!-- ── Navigation item (sidebar) ─────────────────────────── -->
    <Style x:Key="NavListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="6"
                            Margin="4,2"
                            Padding="12,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NavGlyph"
                                       Grid.Column="0"
                                       FontFamily="{StaticResource GlyphFont}"
                                       FontSize="15"
                                       Text="{Binding Glyph}"
                                       Foreground="{StaticResource GlyphInactiveBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <TextBlock x:Name="NavTitle"
                                       Grid.Column="1"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Text="{Binding Title}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBackgroundBrush}" />
                            <Setter TargetName="NavGlyph" Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="NavTitle" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter TargetName="NavTitle" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Search box ────────────────────────────────────────── -->
    <Style x:Key="SearchBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{StaticResource SearchBackgroundBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4" />
                        <Grid Margin="10,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Magnifier"
                                       Grid.Column="0"
                                       FontFamily="{StaticResource GlyphFont}"
                                       FontSize="13"
                                       Text="&#xE721;"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                            <TextBlock x:Name="Watermark"
                                       Grid.Column="1"
                                       Margin="8,0,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="13"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Watermark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Buttons ───────────────────────────────────────────── -->
    <Style x:Key="ViewToggleRadioStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource IconPlaceholderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="BorderBrush" Value="{StaticResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Cards / badges / text ─────────────────────────────── -->
    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="BadgeStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BadgeNeutralBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="10,3" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
    </Style>

    <!-- Implicit text defaults for the whole app (Foreground is inherited from the Window so buttons keep their own colors) -->
    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

</ResourceDictionary>