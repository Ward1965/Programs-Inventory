<Window x:Class="WindowsProgramInventory.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:WindowsProgramInventory.Core"
        Title="{x:Static core:Strings.AppTitle}"
        Width="1180" Height="760"
        MinWidth="860" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────── -->
        <Border Grid.RowSpan="3" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,18,16">
                    <TextBlock Text="{x:Static core:Strings.AppTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static core:Strings.Subtitle}" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource DividerBrush}" Margin="12,0" />

                <ListBox Grid.Row="2" ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         Margin="8,10,8,0" Padding="0" />
            </Grid>
        </Border>

        <Rectangle Grid.Column="1" Grid.RowSpan="3" Fill="{DynamicResource DividerBrush}" />

        <!-- ── Header ───────────────────────────────────────── -->
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <TextBox Grid.Column="0" Width="300"
                     Style="{StaticResource SearchBoxStyle}"
                     Tag="{x:Static core:Strings.SearchPlaceholder}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Spacer -->
            <StackPanel Grid.Column="1" />

            <!-- View mode + icon size -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,18,0">
                <RadioButton Style="{StaticResource ViewToggleRadioStyle}" GroupName="ProgramViews" Margin="0,0,8,0"
                             Content="{x:Static core:Strings.ViewCards}"
                             IsChecked="{Binding Programs.IsCardsView, Mode=OneWay}" />
                <RadioButton Style="{StaticResource ViewToggleRadioStyle}" GroupName="ProgramViews" Margin="0,0,14,0"
                             Content="{x:Static core:Strings.ViewList}"
                             IsChecked="{Binding Programs.IsListView}" />
                <TextBlock Text="{x:Static core:Strings.SettingsIconSize}" Style="{StaticResource SectionLabelStyle}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Width="140" VerticalAlignment="Center"
                        Minimum="{Binding Programs.IconSizeMin}"
                        Maximum="{Binding Programs.IconSizeMax}"
                        IsEnabled="{Binding Programs.IsCardsView}"
                        IsSnapToTickEnabled="True"
                        Ticks="16 20 24 32 40 48 64 96 128 192 256"
                        Value="{Binding Programs.IconSize, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding Programs.IconSize}" VerticalAlignment="Center" Width="34"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="8,0,14,0" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                <Button Content="{x:Static core:Strings.ScanNow}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ScanCommand}" Margin="0,0,8,0" />
            </StackPanel>
        </Grid>

        <!-- ── Main content ─────────────────────────────────── -->
        <ContentControl Grid.Column="2" Grid.Row="1"
                        Content="{Binding CurrentViewModel}"
                        Focusable="False" />

        <!-- ── Status bar ───────────────────────────────────── -->
        <Border Grid.Column="2" Grid.Row="2" Background="{DynamicResource StatusBarBackgroundBrush}">
            <Grid Margin="18,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Width="140" Height="4" Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource ControlBorderBrush}"
                                 Value="{Binding ProgressPercent, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProgressStage}" FontSize="12" Margin="10,0,16,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding LastScanSummary}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" TextAlignment="Right"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Scan lock ────────────────────────────────────────
             During a scan the whole app is blocked (navigation, search, icons,
             slider). Only Cancel stays reachable, rendered above the overlay. -->
        <Border Grid.ColumnSpan="3" Grid.RowSpan="2"
                Background="{DynamicResource ScanOverlayBrush}"
                Panel.ZIndex="500"
                Cursor="Wait"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

        <Button Grid.Column="2" Grid.Row="0"
                Content="{x:Static core:Strings.CancelScan}"
                Style="{StaticResource GhostButtonStyle}"
                Command="{Binding CancelScanCommand}"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                Panel.ZIndex="600"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
    </Grid>
</Window>