{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Program Inventory",
  "version": "1.6.0",
  "identifier": "com.wpi.inventory",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Windows Program Inventory",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "maximized": true,
        "backgroundColor": [13, 15, 22, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "WPI",
    "shortDescription": "Windows Program Inventory"
  }
}